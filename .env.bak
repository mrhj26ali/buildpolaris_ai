# =============================================================================
# BuildPolaris AI - Environment Configuration (ARCH v2.1 compliant)
# Copy to .env and fill in your keys. NEVER commit .env.
# =============================================================================

# --- Application ---
APP__ENVIRONMENT=development
APP__HOST=0.0.0.0
APP__PORT=8001
APP__LOG_LEVEL=INFO

# --- Database (Postgres + pgvector + Apache AGE) - derived, disposable store ---
DATABASE__USER=polaris_ai
DATABASE__PASSWORD=polaris_ai_dev_password
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=polaris_knowledge
DATABASE__POOL_SIZE=5

# --- Redis (token governance counters only - NOT a message bus, ARCH S2.4) ---
REDIS__URL=redis://localhost:6379

# --- Auth: Direction 1, BFF -> AI (ARCH S4.2) ---
# Shared service credential: BFF sends X-Service-Key on every call.
AUTH__SERVICE_KEY=change-me-bff-service-key
# HMAC secret shared with BFF for signing/verifying Scope Assertions
# payload: {company, project, user, role, expires_at}, ~60s TTL
AUTH__SCOPE_ASSERTION_SECRET=change-me-scope-assertion-secret
AUTH__SCOPE_ASSERTION_TTL_SECONDS=60
AUTH__SCOPE_ASSERTION_LEEWAY_SECONDS=10

# --- Auth: Direction 2, AI -> BFF (on-behalf-of, ARCH S4.2) ---
BFF__BASE_URL=http://localhost:8000
BFF__SERVICE_KEY=change-me-ai-service-key
BFF__MCP_PATH=/api/method/buildpolaris_bff.ai_copilot.mcp.mcp_server.handle
BFF__TIMEOUT_SECONDS=30

# --- Model provider: PRIMARY = Google Gemini free tier (OpenAI-compatible) ---
# Get free key: https://aistudio.google.com/apikey
MODEL_PROVIDER__PRIMARY=openai_compatible
MODEL_PROVIDER__OPENAI_COMPATIBLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
MODEL_PROVIDER__OPENAI_COMPATIBLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_PROVIDER__OPENAI_COMPATIBLE_MODEL=gemini-2.0-flash
# --- Fallback: local Ollama (always available, ARCH S3.3 circuit breaker) ---
MODEL_PROVIDER__FALLBACK=ollama
MODEL_PROVIDER__OLLAMA_BASE_URL=http://localhost:11434
MODEL_PROVIDER__OLLAMA_MODEL=qwen2.5:3b-instruct
# --- Optional alternates (kept swappable per NFR-EXT.2 / NFR-MAINT.5) ---
MODEL_PROVIDER__ANTHROPIC_API_KEY=
MODEL_PROVIDER__ANTHROPIC_MODEL=claude-3-5-haiku-latest
MODEL_PROVIDER__OPENAI_API_KEY=
MODEL_PROVIDER__OPENAI_MODEL=gpt-4o-mini
# --- Pinning (NFR-AIGOV.2): never "latest" ---
MODEL_PROVIDER__DEFAULT_TEMPERATURE=0.1
MODEL_PROVIDER__MAX_OUTPUT_TOKENS=2048

# --- Embeddings (local, free, dimension-pinned before first ingestion, ERD S8.1) ---
EMBEDDING__PROVIDER=sentence_transformers
EMBEDDING__MODEL=all-MiniLM-L6-v2
EMBEDDING__DIMENSIONS=384
EMBEDDING__BATCH_SIZE=32

# --- RAG pipeline (ARCH S3.3) ---
RAG__QUERY_REFORMULATIONS=3
RAG__VECTOR_TOP_K_PER_QUERY=10
RAG__FUSED_TOP_N=8
RAG__RRF_K=60
RAG__GRAPH_FAN_IN_LIMIT=10
RAG__RERANK_ENABLED=false
RAG__RERANK_TOP_K=5
RAG__MAX_CONTEXT_CHUNKS=8

# --- Ingestion (FR-8.10 / UC-8.4) ---
INGEST__MAX_FILE_MB=50
INGEST__ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
INGEST__CHUNK_MAX_TOKENS=512
INGEST__CHUNK_OVERLAP_TOKENS=64

# --- Governance (NFR-AIGOV.1) ---
GOVERNANCE__TOKEN_SOFT_CEILING_PER_TENANT=2000000
GOVERNANCE__REQUEST_SOFT_CEILING_PER_TENANT=20000
GOVERNANCE__MAX_TOKENS_PER_REQUEST=4096

# --- Resilience (ARCH S3.3 circuit breaker) ---
RESILIENCE__PROVIDER_TIMEOUT_SECONDS=60
RESILIENCE__BREAKER_FAILURE_THRESHOLD=5
RESILIENCE__BREAKER_RECOVERY_SECONDS=30

# --- Observability (NFR-OBS) ---
OBSERVABILITY__LOG_FORMAT=console
OBSERVABILITY__ENABLE_TRACING=false
