# buildpolaris_ai environment configuration
# Copy this file to `.env` and adjust values as needed.
# `.env` is gitignored — NEVER commit real secrets.

# --- Database (Postgres + pgvector + Apache AGE) ---
DATABASE__USER=polaris_ai
DATABASE__PASSWORD=polaris_ai_dev_password
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=polaris_knowledge

# --- Redis (event bus) ---
REDIS__URL=redis://localhost:6379

# --- Model Provider (Decision Log #6) ---
# Format: "provider/model"
# Local:  ollama/<model>           (no API key needed)
# Hosted: google/gemini-2.5-flash  (requires MODEL_PROVIDER__API_KEY = your GOOGLE_API_KEY)
#         anthropic/claude-...     (requires MODEL_PROVIDER__API_KEY = your ANTHROPIC_API_KEY)
MODEL_PROVIDER__PROVIDER_ID=ollama/qwen2.5:3b-instruct

# API key for hosted providers (leave empty for local Ollama)
# MODEL_PROVIDER__API_KEY=

# Optional: custom base URL (e.g., Ollama on a non-default port)
# MODEL_PROVIDER__BASE_URL=http://localhost:11434