# =============================================================================
# BuildPolaris AI — Environment Configuration
# Copy to .env and fill in your keys. NEVER commit .env.
# =============================================================================

# --- Application ---
APP__ENABLE_DEV_ROUTES=true
APP__ENVIRONMENT=development

# --- Database (Postgres + pgvector + Apache AGE) ---
DATABASE__USER=polaris_ai
DATABASE__PASSWORD=polaris_ai_dev_password
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=polaris_knowledge

# --- Redis ---
REDIS__URL=redis://localhost:6379

# --- Authentication ---
# mode: dev | secret | jwks
AUTH__MODE=dev
AUTH__JWT_SECRET=buildpolaris-dev-secret-key-change-in-production
# AUTH__JWKS_URL=
# AUTH__EXPECTED_ISSUER=buildpolaris-bff
# AUTH__EXPECTED_AUDIENCE=buildpolaris-ai
AUTH__LEEWAY_SECONDS=30
AUTH__INGEST_API_KEY=dev-ingest-key-change-in-production

# --- Model Provider (Primary: Groq free tier) ---
# Get free key: https://console.groq.com/keys (30 req/min, no credit card)
MODEL_PROVIDER__PRIMARY_PROVIDER=groq
MODEL_PROVIDER__GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
MODEL_PROVIDER__GROQ_MODEL=llama-3.1-70b-versatile

# --- Model Provider (Fallback: Google Gemini free tier) ---
# Get free key: https://aistudio.google.com/apikey (15 RPM free)
MODEL_PROVIDER__FALLBACK_PROVIDER=gemini
MODEL_PROVIDER__GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
MODEL_PROVIDER__GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
# Options: ollama (local, free), sentence-transformers (local, free)
EMBEDDING__PROVIDER=sentence-transformers
EMBEDDING__MODEL=all-MiniLM-L6-v2
EMBEDDING__DIMENSIONS=384
# For ollama: EMBEDDING__PROVIDER=ollama, EMBEDDING__MODEL=nomic-embed-text

# --- Retrieval (Advanced RAG) ---
RAG__VECTOR_SEARCH_LIMIT=10
RAG__GRAPH_ENRICH_LIMIT=5
RAG__RERANK_TOP_K=5
RAG__JACCARD_THRESHOLD=0.85
RAG__MAX_GENERATION_RETRIES=2
RAG__USE_RAG_FUSION=true
RAG__USE_QUERY_TRANSFORM=true
RAG__USE_HYDE=true
RAG__CHUNK_SIZE=512
RAG__CHUNK_OVERLAP=64

# --- BFF Integration ---
BFF__MODE=mock
# BFF__BASE_URL=http://localhost:8000
BFF__API_TOKEN=
BFF__TIMEOUT_SECONDS=10

# --- Ingest (CDC) ---
INGEST__TRANSPORT=http
INGEST__STREAM_KEY=bp.cdc.events
INGEST__DLQ_KEY=bp.cdc.events.dlq
INGEST__PROCESSED_SET_KEY=bp.cdc.processed
INGEST__CONSUMER_GROUP=bp_ai_ingest
INGEST__BATCH_SIZE=10
INGEST__MAX_RETRIES=3

# --- Governance ---
GOVERNANCE__TOKEN_SOFT_CEILING_PER_TENANT=2000000
GOVERNANCE__TOKEN_HARD_CEILING_PER_TENANT=3000000
GOVERNANCE__REQUEST_SOFT_CEILING_PER_TENANT=20000
GOVERNANCE__MAX_TOKENS_PER_REQUEST=4096

# --- Resilience ---
RESILIENCE__PROVIDER_TIMEOUT_SECONDS=60
RESILIENCE__BREAKER_FAILURE_THRESHOLD=5
RESILIENCE__BREAKER_RECOVERY_SECONDS=30

# --- Observability ---
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_FORMAT=console
OBSERVABILITY__ENABLE_TRACING=false
